<div class="container" onswipe="swipe">
    <div class="mainContainer">
        <div class="tile-row">
            <image src="common/index/1.PNG" class="image"
                   style="animation-name: {{ imageStates[0].animationName }};"
                   onclick="rotateImage($event, 0)">
            </image>
            <image src="common/index/2.PNG" class="image"
                   style="animation-name: {{ imageStates[1].animationName }};"
                   onclick="rotateImage($event, 1)">
            </image>
        </div>
        <div class="tile-row">
            <image src="common/index/3.PNG" class="image"
                   style="animation-name: {{ imageStates[2].animationName }};"
                   onclick="rotateImage($event, 2)">
            </image>
            <image src="common/index/4.PNG" class="image"
                   style="animation-name: {{ imageStates[3].animationName }};"
                   onclick="rotateImage($event, 3)">
            </image>
        </div>
        <image
                src="common/nextLevel.png"
                class="nextLevel"
                style="opacity: {{ isWon ? 1 : 0 }};
                        pointer-events: {{ isWon ? 'auto' : 'none' }};"
                onclick="goNextLevel">
        </image>
    </div>
</div>
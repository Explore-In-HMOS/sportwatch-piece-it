<div class="container" onswipe="swipe">
    <div class="mainContainer">
        <div class="tile-row">
            <image src="common/level3/huawei_part_0_0.jpg" class="image"
                   style="animation-name: {{ imageStates[0].animationName }};" onclick="rotateImage($event, 0)"></image>
            <image src="common/level3/huawei_part_0_1.jpg" class="image"
                   style="animation-name: {{ imageStates[1].animationName }};" onclick="rotateImage($event, 1)"></image>
            <image src="common/level3/huawei_part_0_2.jpg" class="image"
                   style="animation-name: {{ imageStates[2].animationName }};" onclick="rotateImage($event, 2)"></image>
            <image src="common/level3/huawei_part_0_3.jpg" class="image"
                   style="animation-name: {{ imageStates[3].animationName }};" onclick="rotateImage($event, 3)"></image>
        </div>

        <div class="tile-row">
            <image src="common/level3/huawei_part_1_0.jpg" class="image"
                   style="animation-name: {{ imageStates[4].animationName }};" onclick="rotateImage($event, 4)"></image>
            <image src="common/level3/huawei_part_1_1.jpg" class="image"
                   style="animation-name: {{ imageStates[5].animationName }};" onclick="rotateImage($event, 5)"></image>
            <image src="common/level3/huawei_part_1_2.jpg" class="image"
                   style="animation-name: {{ imageStates[6].animationName }};" onclick="rotateImage($event, 6)"></image>
            <image src="common/level3/huawei_part_1_3.jpg" class="image"
                   style="animation-name: {{ imageStates[7].animationName }};" onclick="rotateImage($event, 7)"></image>
        </div>
        <image
                src="common/nextLevel.png"
                class="nextLevel"
                style="opacity: {{ isWon ? 1 : 0 }};
                        pointer-events: {{ isWon ? 'auto' : 'none' }};"
                onclick="goNextLevel">
        </image>
    </div>
</div>